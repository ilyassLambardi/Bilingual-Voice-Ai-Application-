{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: FastAPI (main.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/main.py",
      "python": "C:\\Users\\ILYASS\\anaconda3\\envs\\ILjourney\\python.exe",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": { "PYTHONUNBUFFERED": "1" }
    },
    {
      "name": "Backend: Uvicorn (reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["main:app", "--reload", "--host", "0.0.0.0", "--port", "8000"],
      "python": "C:\\Users\\ILYASS\\anaconda3\\envs\\ILjourney\\python.exe",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": { "PYTHONUNBUFFERED": "1" }
    },
    {
      "name": "Frontend: Chrome (http://localhost:5173)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend/src",
      "sourceMaps": true
    },
    {
      "name": "Frontend: Edge (http://localhost:5173)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend/src",
      "sourceMaps": true
    }
  ],
  "compounds": [
    {
      "name": "Full Stack (Backend + Chrome)",
      "configurations": ["Backend: Uvicorn (reload)", "Frontend: Chrome (http://localhost:5173)"],
      "stopAll": true
    }
  ]
}
